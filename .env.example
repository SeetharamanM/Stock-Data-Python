# Copy this file to .env and fill it in. Lines starting with # are ignored.

# Trendlyne: your personal MCP server URL (trendlyne.com > profile menu > MCP).
# Treat it like a password: it may contain your access key.
TRENDLYNE_MCP_URL=

# INDmoney and Kite work with these defaults. Set one to an empty value to turn it off.
# INDMONEY_MCP_URL=https://mcp.indmoney.com/mcp
# KITE_MCP_URL=https://mcp.kite.trade/mcp

# Where the app runs. Logins redirect back to PUBLIC_BASE_URL, so open the app at that address.
# HOST=127.0.0.1
# PORT=8000
# PUBLIC_BASE_URL=http://localhost:8000

# Extra host:port names allowed to reach the app, comma separated (rarely needed).
# ALLOWED_HOSTS=

# Saved logins are kept in DATA_DIR/tokens (readable by your user only).
# DATA_DIR=instance

# FLASK_DEBUG=1
