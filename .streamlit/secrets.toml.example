# Streamlit secrets. On Streamlit Community Cloud paste these into
# App settings > Secrets. Locally, copy this file to .streamlit/secrets.toml
# (git-ignored). Never commit the real file.

# The exact address the app is served at. INDmoney sends logins back here.
PUBLIC_BASE_URL = "https://your-app-name.streamlit.app"

# Strongly recommended: visitors must enter this before using the app.
APP_PASSWORD = "choose-a-long-random-password"

# Optional: your personal Trendlyne MCP URL. Used only after APP_PASSWORD is
# entered; without APP_PASSWORD, each visitor pastes their own URL instead.
TRENDLYNE_MCP_URL = ""

# Defaults; set one to "" to turn that source off.
# INDMONEY_MCP_URL = "https://mcp.indmoney.com/mcp"
# KITE_MCP_URL = "https://mcp.kite.trade/mcp"
